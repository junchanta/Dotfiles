#!/usr/bin/env bash
# このマシンの環境が、リポジトリの定義どおりに動いているかを確かめる。
# リポジトリも設定も変更しない。問題があれば [ERROR] の行を出し、終了コード 1 で終わる。
# (Neovim の確認は普段の設定で起動するので、未取得のプラグインがあれば、その取得は走る)
#
# 使い方: scripts/check [--quick]
#   --quick  時間のかかる Neovim の確認を省く

set -u
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"

repo="$(cd "$(dirname "$0")/.." && pwd -P)"
quick=0
[ "${1:-}" = "--quick" ] && quick=1

os="$(uname -s)"
fail=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 出力の各行の先頭に、種類を付ける
#   [OK]    確かめて、問題がなかった
#   [ERROR] 問題がある。直す必要がある
#   [WARN]  直すことを勧めるが、失敗にはしない
#   [INFO]  知らせるだけ。直す必要はない
#   (字下げだけの行は、直前の行の補足)
section() { printf '\n== %s\n' "$1"; }
ok() { printf '[OK]    %s\n' "$1"; }
ng() {
  printf '[ERROR] %s\n' "$1"
  fail=1
}
info() { printf '[INFO]  %s\n' "$1"; }
warn() { printf '[WARN]  %s\n' "$1"; }
detail() { printf '        %s\n' "$1"; }
details_from() { head -n "$2" "$1" | while IFS= read -r line; do detail "$line"; done; }

# ---------------------------------------------------------------------------
section "リポジトリ"

if [ "$repo" = "$(cd "$HOME/Work/Dotfiles" 2>/dev/null && pwd -P)" ]; then
  # shellcheck disable=SC2088
  ok "~/Work/Dotfiles にある"
else
  ng "リポジトリが ~/Work/Dotfiles にない($repo)。リンクの張り先がこの場所に固定されている"
fi

host="$(cat "$HOME/.config/dotfiles/host" 2>/dev/null || true)"
if [ -z "$host" ]; then
  ng "このマシンにはまだ反映されていない。scripts/setup <host> を実行する"
  exit 1
fi
ok "このマシンの名前は $host"

if [ -n "$(git -C "$repo" status --porcelain)" ]; then
  info "コミットしていない変更がある(git status で確認する)"
fi

# ---------------------------------------------------------------------------
section "反映の状態"

# 反映が最後まで終わったときにだけ更新される目印を見る。
# 世代の一覧(プロファイル)は反映の途中で先に進むので、途中で失敗した反映を見分けられない
gen="$(realpath "${XDG_STATE_HOME:-$HOME/.local/state}/home-manager/gcroots/current-home" 2>/dev/null || true)"
if [ -z "$gen" ]; then
  ng "最後まで終わった反映が見つからない。scripts/switch を実行する"
  exit 1
fi

# --impure は、ユーザー名とホームの場所を $USER と $HOME から読み取るために要る(flake.nix を参照)
if built="$(nix build --impure "$repo#homeConfigurations.$host.activationPackage" --no-link --print-out-paths 2>"$tmp/build.err")"; then
  if [ "$built" = "$gen" ]; then
    ok "リポジトリの定義は反映済み"
  else
    ng "反映されていない変更がある。scripts/switch を実行する"
  fi
else
  ng "リポジトリの定義をビルドできない"
  tail -n 15 "$tmp/build.err" >"$tmp/build.tail"
  details_from "$tmp/build.tail" 15
fi

# ---------------------------------------------------------------------------
section "設定ファイルのリンク"

files_root="$(realpath "$gen/home-files")"
if ! find "$files_root" \( -type l -o -type f \) -print0 >"$tmp/files" 2>"$tmp/find.err" || [ ! -s "$tmp/files" ]; then
  ng "管理しているファイルの一覧を取れない"
  details_from "$tmp/find.err" 5
else
  count=0
  bad=0
  while IFS= read -r -d '' src; do
    rel="${src#"$files_root"/}"
    dst="$HOME/$rel"
    count=$((count + 1))
    if [ ! -e "$dst" ]; then
      ng "リンクが切れているか、存在しない: ~/$rel"
      bad=$((bad + 1))
    elif [ "$(realpath "$dst")" != "$(realpath "$src")" ]; then
      ng "別のファイルに置き換わっている: ~/$rel"
      bad=$((bad + 1))
    fi
  done <"$tmp/files"
  [ "$bad" -eq 0 ] && ok "$count 個のリンクがすべて正しい"
fi

# ---------------------------------------------------------------------------
section "コマンド"

fish="$HOME/.nix-profile/bin/fish"
# shellcheck disable=SC2012
nix_bins="$(ls "$gen/home-path/bin" | tr '\n' ' ')"
local_bins=""
if [ -d "$HOME/.local/bin" ]; then
  for f in "$HOME/.local/bin"/*; do
    [ -f "$f" ] && [ -x "$f" ] && local_bins="$local_bins $(basename "$f")"
  done
fi
# 公式のインストーラで入れるツール(名前、コマンドの場所、URL、引数のタブ区切り)
installer_tools="$HOME/.config/dotfiles/installer-tools"
# Homebrew で入れるもの(名前、確かめる場所、Homebrew に渡す行のタブ区切り)。このうちコマンドだけを見る
homebrew_apps="$HOME/.config/dotfiles/homebrew-apps"
# 「名前<TAB>コマンドの場所」を集める。入っていることと、そのコマンドが使われることを確かめる
: >"$tmp/tools"
if [ -s "$installer_tools" ]; then
  while IFS="$(printf '\t')" read -r name present _ _; do
    printf '%s\t%s\n' "$name" "$present" >>"$tmp/tools"
  done <"$installer_tools"
fi
if [ -s "$homebrew_apps" ]; then
  while IFS="$(printf '\t')" read -r name present _; do
    case "$present" in
    */bin/*) printf '%s\t%s\n' "$name" "$present" >>"$tmp/tools" ;;
    esac
  done <"$homebrew_apps"
fi
installer_bins=""
while IFS="$(printf '\t')" read -r _ present; do
  installer_bins="$installer_bins $(basename "$present")"
done <"$tmp/tools"

# 新しく開いたログインシェルで、各コマンドがどこに解決されるかを調べる
# shellcheck disable=SC2016,SC2086
env -i HOME="$HOME" USER="$USER" TERM=xterm-256color "$fish" -l -i -c '
  for c in $argv
    printf "%s\t%s\n" $c (command -s $c 2>/dev/null; or echo "-")
  end' $nix_bins $local_bins $installer_bins >"$tmp/resolved" 2>"$tmp/fish.err"

if [ -s "$tmp/fish.err" ]; then
  ng "fish の起動時にエラーが出る"
  details_from "$tmp/fish.err" 10
else
  ok "fish がエラーなしで起動する"
fi

resolved_path() { awk -F '\t' -v name="$1" '$1 == name { print $2; exit }' "$tmp/resolved"; }

# shellcheck disable=SC2086
expected=$(set -- $nix_bins $local_bins $installer_bins && echo $#)
if [ "$(wc -l <"$tmp/resolved" | tr -d ' ')" -ne "$expected" ]; then
  ng "コマンドの解決先を調べられなかった(fish が途中で止まった)"
else
  # ~/.local/bin は、インストーラが入れるコマンド(claude など)の置き場で、最優先にしている
  bad=0
  for name in $local_bins; do
    path="$(resolved_path "$name")"
    if [ "$path" != "$HOME/.local/bin/$name" ]; then
      ng "$name が ~/.local/bin のものではなく $path に解決される(PATH の順序を確かめる)"
      bad=$((bad + 1))
    fi
  done
  # shellcheck disable=SC2088
  [ -n "$local_bins" ] && [ "$bad" -eq 0 ] && ok "~/.local/bin のコマンドは、すべてそこのものが使われる"

  bad=0
  for name in $nix_bins; do
    case " $local_bins " in *" $name "*) continue ;; esac
    path="$(resolved_path "$name")"
    if [ "$path" != "$HOME/.nix-profile/bin/$name" ]; then
      ng "$name が Nix のものではなく $path に解決される(PATH の順序を確かめる)"
      bad=$((bad + 1))
    fi
  done
  [ "$bad" -eq 0 ] && ok "Nix で入れたコマンドは、すべて Nix のものが使われる"
fi

# 自分で更新するツール(Claude Code、opencode、Codex)が、入っていて、そのコマンドが使われること
if [ -s "$tmp/tools" ]; then
  bad=0
  while IFS="$(printf '\t')" read -r name present; do
    path="$(resolved_path "$(basename "$present")")"
    if [ ! -x "$present" ]; then
      ng "$name が入っていない。scripts/switch で入る"
      bad=$((bad + 1))
    elif [ -z "$path" ]; then
      # 解決先を調べられなかった。上で [ERROR] を出している
      bad=$((bad + 1))
    elif [ "$path" = "-" ]; then
      ng "$name は入っているが、コマンドの場所($(dirname "$present"))が PATH に入っていない。config/fish/common.fish に足す"
      bad=$((bad + 1))
    elif [ "$path" != "$present" ]; then
      ng "$name のコマンドが $present ではなく $path に解決される。別の方法で入れた古いものが残っているので、消す"
      bad=$((bad + 1))
    fi
  done <"$tmp/tools"
  [ "$bad" -eq 0 ] && ok "自分で更新するツール(Claude Code、opencode、Codex)が入っていて、それが使われる"
fi

if [ "$os" = Darwin ]; then
  bad=0
  for name in $nix_bins; do
    if [ -e "/opt/homebrew/bin/$name" ]; then
      ng "Homebrew にも $name がある($(readlink "/opt/homebrew/bin/$name"))。brew uninstall で消す"
      bad=$((bad + 1))
    fi
  done
  [ "$bad" -eq 0 ] && ok "Homebrew と重複しているコマンドはない"
fi

# ---------------------------------------------------------------------------
section "ログインシェル"

if [ "$os" = Darwin ]; then
  login_shell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
else
  login_shell="$(getent passwd "$USER" | cut -d: -f7)"
fi
if [ "$login_shell" = "$fish" ]; then
  ok "ログインシェルは Nix の fish"
else
  ng "ログインシェルが Nix の fish ではない($login_shell)。scripts/setup $host を実行する"
fi

# 起動したときのログインシェルを覚えたまま動いているアプリを探す。
# そのシェルが消えていると、アプリが新しいシェルを開く操作(新しいタブ、キーに割り当てたコマンド)が失敗する
ps exww -o pid=,command= 2>/dev/null | awk '{
  shell = ""
  for (i = 2; i <= NF; i++) if ($i ~ /^SHELL=\/[A-Za-z0-9_.\/-]+$/) shell = substr($i, 7)
  if (shell != "") print $1 "\t" shell
}' >"$tmp/shells"
bad=0
# shellcheck disable=SC2013 # 上の awk が、空白を含まないパスだけを取り出している
for shell in $(cut -f2 "$tmp/shells" | sort -u); do
  [ -x "$shell" ] && continue
  names="$(awk -F '\t' -v s="$shell" '$2 == s { print $1 }' "$tmp/shells" | while read -r pid; do basename "$(ps -o comm= -p "$pid" 2>/dev/null)"; done | sort -u | head -n 8 | tr '\n' ' ')"
  ng "存在しないシェル($shell)を使い続けているアプリがある: $names"
  detail "そのアプリを起動し直すか、ログアウトして入り直す"
  bad=$((bad + 1))
done
[ "$bad" -eq 0 ] && ok "動いているアプリは、存在するシェルを使っている"

# 入れ替えや削除で実行ファイルが消えたのに、古いものから動き続けているアプリを探す。
# 動いてはいるが、足りない部品を読み込めずに一部の操作が失敗することがある
if [ "$os" = Linux ]; then
  # Linux の ps は実行ファイルの場所を出さない。/proc から、消えた実行ファイルの印を読む
  for exe in /proc/[0-9]*/exe; do
    [ -O "${exe%/exe}" ] || continue
    target="$(readlink "$exe" 2>/dev/null)" || continue
    case "$target" in
    *" (deleted)") basename "${target% (deleted)}" ;;
    esac
  done
else
  ps -x -o pid=,comm= 2>/dev/null | while read -r _ exe; do
    case "$exe" in
    /*) [ -e "$exe" ] || basename "$exe" ;;
    esac
  done
fi | sort | uniq -c | awk '{ printf "%s(%s 個)\n", $2, $1 }' >"$tmp/gone"
if [ -s "$tmp/gone" ]; then
  warn "消えた実行ファイルから動き続けているアプリがある: $(tr '\n' ' ' <"$tmp/gone")"
  detail "入れ替える前から動いているものである。終了して開き直すと、新しいものに切り替わる"
else
  ok "動いているアプリは、すべて今ある実行ファイルから動いている"
fi

# ---------------------------------------------------------------------------
section "アプリごとの設定"

# tmux: 設定を実行せずに文法だけ確かめる
sock="dotfiles-check-$$"
if tmux -L "$sock" -f /dev/null new-session -d -s check 'sleep 30' 2>"$tmp/tmux.err"; then
  if tmux -L "$sock" source-file -n "$HOME/.tmux.conf" 2>>"$tmp/tmux.err"; then
    ok "tmux の設定に文法の誤りがない"
  else
    ng "tmux の設定に誤りがある"
    details_from "$tmp/tmux.err" 5
  fi
  tmux -L "$sock" kill-server 2>/dev/null
else
  ng "tmux を起動できない"
fi

if git config --global --list >/dev/null 2>"$tmp/git.err"; then
  ok "git の設定を読める"
else
  ng "git の設定を読めない"
  details_from "$tmp/git.err" 5
fi

ghostty="/Applications/Ghostty.app/Contents/MacOS/ghostty"
[ -x "$ghostty" ] || ghostty="$(command -v ghostty 2>/dev/null || true)"
if [ -n "$ghostty" ]; then
  # ghostty の中から実行すると、動いている版の同梱ファイルの場所が環境変数で渡る。
  # それを外して、設定がその版の ghostty 単体で通るかを確かめる
  if env -u GHOSTTY_RESOURCES_DIR "$ghostty" +validate-config >"$tmp/ghostty.out" 2>&1; then
    ok "ghostty の設定に誤りがない"
  else
    ng "ghostty の設定に誤りがある"
    details_from "$tmp/ghostty.out" 5
  fi
fi

if [ "$os" = Darwin ] && [ -d "$HOME/.config/sketchybar" ]; then
  bad=0
  for f in "$HOME/.config/sketchybar/sketchybarrc" "$HOME/.config/sketchybar/plugins"/*.sh; do
    if [ ! -x "$f" ]; then
      ng "sketchybar のスクリプトがないか、実行できない: $f"
      bad=$((bad + 1))
    fi
  done
  [ "$bad" -eq 0 ] && ok "sketchybar のスクリプトがそろっていて、実行権限がある"
fi

# ---------------------------------------------------------------------------
if [ "$os" = Darwin ]; then
  section "フォント"

  marker="$files_root/Library/Fonts/.home-manager-fonts-version"
  if [ ! -e "$marker" ]; then
    info "Nix で入れるフォントは定義されていない"
  else
    fonts_src="$(cat "$marker")/share/fonts"
    fonts_dst="$HOME/Library/Fonts/HomeManager"
    total=0
    missing=0
    while IFS= read -r -d '' f; do
      total=$((total + 1))
      [ -e "$fonts_dst/${f#"$fonts_src"/}" ] || missing=$((missing + 1))
    done < <(find -L "$fonts_src" -type f -print0 2>/dev/null)
    if [ "$total" -eq 0 ]; then
      info "Nix で入れるフォントは定義されていない"
    elif [ "$missing" -eq 0 ]; then
      ok "Nix で入れた $total 個のフォントファイルがすべてある"
    else
      ng "$missing 個のフォントファイルがない($fonts_dst)。scripts/switch を実行する"
    fi
  fi

  section "常駐ツール"

  found=0
  for plist in "$gen"/LaunchAgents/*.plist; do
    [ -e "$plist" ] || continue
    found=1
    label="$(basename "$plist" .plist)"
    name="${label##*.}"
    if launchctl print "gui/$(id -u)/$label" 2>/dev/null | grep -q 'state = running'; then
      ok "$name が動いている"
    else
      ng "$name が動いていない"
      case "$name" in
      yabai | skhd) detail "初めての反映と版を上げた後は、アクセシビリティの許可が要る(README の「困ったとき」)" ;;
      esac
    fi
    # 同じ名前のものが、Nix 以外の場所(以前の Homebrew 版など)から動いていないこと
    for pid in $(pgrep -x "$name" 2>/dev/null); do
      exe="$(ps -o comm= -p "$pid" 2>/dev/null)"
      case "$exe" in
      /nix/store/* | "") ;;
      *) ng "$name が Nix 以外の場所から動いている($exe)" ;;
      esac
    done
  done
  [ "$found" -eq 0 ] && info "home-manager が管理する常駐ツールはない"

  if [ -e "$gen/LaunchAgents/org.nix-community.home.yabai.plist" ]; then
    if yabai -m query --spaces >/dev/null 2>&1; then
      ok "yabai が応答する"
    else
      ng "yabai が応答しない"
    fi
  fi

  section "Homebrew で入れるもの"

  # 確かめる場所はコロン区切りで、どれかにあればよい
  if [ ! -s "$homebrew_apps" ]; then
    info "Homebrew で入れるものは定義されていない"
  else
    total=0
    bad=0
    while IFS="$(printf '\t')" read -r name present _; do
      total=$((total + 1))
      found=0
      old_ifs="$IFS"
      IFS=:
      for path in $present; do
        [ -e "$path" ] && found=1
      done
      IFS="$old_ifs"
      if [ "$found" -eq 0 ]; then
        ng "$name が入っていない。scripts/switch で入る(Homebrew がなければ scripts/setup $host)"
        bad=$((bad + 1))
      fi
    done <"$homebrew_apps"
    if [ "$total" -eq 0 ]; then
      ng "Homebrew で入れるものの一覧を読めない($homebrew_apps)"
    elif [ "$bad" -eq 0 ]; then
      ok "定義した $total 個(GUI アプリと Codex)がすべて入っている"
    fi
  fi
fi

# ---------------------------------------------------------------------------
section "Neovim"

if [ "$quick" -eq 1 ]; then
  info "省略した(--quick)"
else
  samples="$tmp/nvim"
  mkdir -p "$samples"
  cat >"$samples/sample.md" <<'EOF'
# sample

- [ ] todo

```lua
local function f(a, b)
  return a + b
end
```

```python
print(1)
```
EOF
  printf 'local function f(a, b)\n  return a + b\nend\n' >"$samples/sample.lua"
  printf 'def f(a):\n    return a\n' >"$samples/sample.py"
  printf 'const f = (a: number) => a;\n' >"$samples/sample.ts"
  printf '#!/bin/sh\necho hi\n' >"$samples/sample.sh"

  info "Neovim を確かめる(20 秒ほど。プラグインをまだ取得していないマシンでは、取得が終わるまで数分かかる)"
  # 起動の途中で止まった場合に備えて、外側からも時間を区切る
  DOTFILES_CHECK_DIR="$samples" nvim --headless "+luafile $repo/scripts/lib/nvim-check.lua" >"$tmp/nvim.out" 2>&1 &
  nvim_pid=$!
  (sleep 600 && kill "$nvim_pid" 2>/dev/null) &
  timer_pid=$!
  wait "$nvim_pid"
  nvim_rc=$?
  kill "$timer_pid" 2>/dev/null
  wait "$timer_pid" 2>/dev/null

  if [ "$nvim_rc" -ge 128 ]; then
    ng "Neovim の確認が 10 分たっても終わらなかった"
    details_from "$tmp/nvim.out" 30
  elif [ "$nvim_rc" -ne 0 ]; then
    ng "Neovim でエラーが出る"
    details_from "$tmp/nvim.out" 30
  elif grep -qE 'E[0-9]+:|Error|stack traceback' "$tmp/nvim.out"; then
    ng "Neovim がエラーらしい出力をした"
    details_from "$tmp/nvim.out" 30
  else
    ok "ファイルを開き、全プラグインを読み込み、キー操作を試してもエラーが出ない"
  fi
fi

# ---------------------------------------------------------------------------
printf '\n'
if [ "$fail" -eq 0 ]; then
  ok "問題は見つからなかった"
else
  ng "問題がある。上の [ERROR] を直してから、もう一度実行する"
fi
exit "$fail"
