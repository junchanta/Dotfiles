#!/usr/bin/env bash
# このマシンの環境が、リポジトリの定義どおりに動いているかを確かめる。
# 何も変更しない。問題があれば ✗ を出し、終了コード 1 で終わる。
#
# 使い方: scripts/check [--quick]
#   --quick  時間のかかる Neovim の確認を省く

set -u
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"

repo="$(cd "$(dirname "$0")/.." && pwd -P)"
quick=0
[ "${1:-}" = "--quick" ] && quick=1

os="$(uname -s)"
fail=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

section() { printf '\n%s\n' "$1"; }
ok() { printf '  ✓ %s\n' "$1"; }
ng() {
  printf '  ✗ %s\n' "$1"
  fail=1
}
note() { printf '      %s\n' "$1"; }

# ---------------------------------------------------------------------------
section "リポジトリ"

if [ "$repo" = "$(cd "$HOME/Work/Dotfiles" 2>/dev/null && pwd -P)" ]; then
  # shellcheck disable=SC2088
  ok "~/Work/Dotfiles にある"
else
  ng "リポジトリが ~/Work/Dotfiles にない($repo)。リンクの張り先がこの場所に固定されている"
fi

host="$(cat "$HOME/.config/dotfiles/host" 2>/dev/null || true)"
if [ -z "$host" ]; then
  ng "このマシンにはまだ反映されていない。scripts/setup <host> を実行する"
  exit 1
fi
ok "このマシンの名前は $host"

if [ -n "$(git -C "$repo" status --porcelain)" ]; then
  note "コミットしていない変更がある(git status で確認する)"
fi

# ---------------------------------------------------------------------------
section "反映の状態"

profile="$HOME/.local/state/nix/profiles/home-manager"
[ -e "$profile" ] || profile="/nix/var/nix/profiles/per-user/$USER/home-manager"
gen="$(realpath "$profile" 2>/dev/null || true)"

if built="$(nix build "$repo#homeConfigurations.$host.activationPackage" --no-link --print-out-paths 2>"$tmp/build.err")"; then
  if [ "$built" = "$gen" ]; then
    ok "リポジトリの定義は反映済み"
  else
    ng "反映されていない変更がある。scripts/switch を実行する"
  fi
else
  ng "リポジトリの定義をビルドできない"
  tail -n 15 "$tmp/build.err" | while IFS= read -r line; do note "$line"; done
fi

if [ -z "$gen" ]; then
  ng "home-manager の世代が見つからない"
  exit 1
fi

# ---------------------------------------------------------------------------
section "設定ファイルのリンク"

files_root="$(realpath "$gen/home-files")"
count=0
bad=0
while IFS= read -r -d '' src; do
  rel="${src#"$files_root"/}"
  dst="$HOME/$rel"
  count=$((count + 1))
  if [ ! -e "$dst" ]; then
    ng "リンクが切れているか、存在しない: ~/$rel"
    bad=$((bad + 1))
  elif [ "$(realpath "$dst")" != "$(realpath "$src")" ]; then
    ng "別のファイルに置き換わっている: ~/$rel"
    bad=$((bad + 1))
  fi
done < <(find "$files_root" \( -type l -o -type f \) -print0)
[ "$bad" -eq 0 ] && ok "$count 個のリンクがすべて正しい"

# ---------------------------------------------------------------------------
section "コマンド"

fish="$HOME/.nix-profile/bin/fish"
# shellcheck disable=SC2012
bins="$(ls "$gen/home-path/bin" | tr '\n' ' ')"

# 新しく開いたログインシェルで、Nix で入れたコマンドがどこに解決されるかを調べる
# shellcheck disable=SC2016,SC2086
env -i HOME="$HOME" USER="$USER" TERM=xterm-256color "$fish" -l -i -c '
  for c in $argv
    printf "%s\t%s\n" $c (command -s $c 2>/dev/null; or echo "-")
  end' $bins >"$tmp/resolved" 2>"$tmp/fish.err"

if [ -s "$tmp/fish.err" ]; then
  ng "fish の起動時にエラーが出る"
  head -n 10 "$tmp/fish.err" | while IFS= read -r line; do note "$line"; done
else
  ok "fish がエラーなしで起動する"
fi

bad=0
while IFS="$(printf '\t')" read -r name path; do
  if [ "$path" != "$HOME/.nix-profile/bin/$name" ]; then
    ng "$name が Nix のものではなく $path に解決される(PATH の順序を確かめる)"
    bad=$((bad + 1))
  fi
done <"$tmp/resolved"
[ "$bad" -eq 0 ] && ok "Nix で入れたコマンドは、すべて Nix のものが使われる"

if [ "$os" = Darwin ]; then
  bad=0
  for name in $bins; do
    if [ -e "/opt/homebrew/bin/$name" ]; then
      ng "Homebrew にも $name がある($(readlink "/opt/homebrew/bin/$name"))。brew uninstall で消す"
      bad=$((bad + 1))
    fi
  done
  [ "$bad" -eq 0 ] && ok "Homebrew と重複しているコマンドはない"
fi

# ---------------------------------------------------------------------------
section "ログインシェル"

if [ "$os" = Darwin ]; then
  login_shell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
else
  login_shell="$(getent passwd "$USER" | cut -d: -f7)"
fi
if [ "$login_shell" = "$fish" ]; then
  ok "ログインシェルは Nix の fish"
else
  ng "ログインシェルが Nix の fish ではない($login_shell)。scripts/setup $host を実行する"
fi

# ---------------------------------------------------------------------------
section "アプリごとの設定"

# tmux: 設定を実行せずに文法だけ確かめる
sock="dotfiles-check-$$"
if tmux -L "$sock" -f /dev/null new-session -d -s check 'sleep 30' 2>"$tmp/tmux.err"; then
  if tmux -L "$sock" source-file -n "$HOME/.tmux.conf" 2>>"$tmp/tmux.err"; then
    ok "tmux の設定に文法の誤りがない"
  else
    ng "tmux の設定に誤りがある"
    head -n 5 "$tmp/tmux.err" | while IFS= read -r line; do note "$line"; done
  fi
  tmux -L "$sock" kill-server 2>/dev/null
else
  ng "tmux を起動できない"
fi

if git config --global --list >/dev/null 2>"$tmp/git.err"; then
  ok "git の設定を読める"
else
  ng "git の設定を読めない"
  head -n 5 "$tmp/git.err" | while IFS= read -r line; do note "$line"; done
fi

ghostty="/Applications/Ghostty.app/Contents/MacOS/ghostty"
if [ -x "$ghostty" ]; then
  if "$ghostty" +validate-config >"$tmp/ghostty.out" 2>&1; then
    ok "ghostty の設定に誤りがない"
  else
    ng "ghostty の設定に誤りがある"
    head -n 5 "$tmp/ghostty.out" | while IFS= read -r line; do note "$line"; done
  fi
fi

# ---------------------------------------------------------------------------
if [ "$os" = Darwin ]; then
  section "常駐ツール"

  found=0
  for plist in "$gen"/LaunchAgents/*.plist; do
    [ -e "$plist" ] || continue
    found=1
    label="$(basename "$plist" .plist)"
    if launchctl print "gui/$(id -u)/$label" 2>/dev/null | grep -q 'state = running'; then
      ok "$label が動いている"
    else
      ng "$label が動いていない(launchctl print gui/$(id -u)/$label で確かめる)"
    fi
  done
  [ "$found" -eq 0 ] && note "home-manager が管理する常駐ツールはない"

  if [ -e "$gen/LaunchAgents/org.nix-community.home.yabai.plist" ]; then
    if yabai -m query --spaces >/dev/null 2>&1; then
      ok "yabai がウィンドウを操作できる"
    else
      ng "yabai がウィンドウを操作できない。システム設定のアクセシビリティで yabai を許可する"
    fi
  fi

  section "Homebrew の GUI アプリ"

  brewfile="$HOME/.config/dotfiles/Brewfile"
  if [ ! -e "$brewfile" ]; then
    note "Homebrew で入れるものは定義されていない"
  elif [ ! -x /opt/homebrew/bin/brew ]; then
    ng "Homebrew が入っていない。scripts/setup $host を実行する"
  elif HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle check --no-upgrade --verbose --file="$brewfile" >"$tmp/brew.out" 2>&1; then
    ok "定義した GUI アプリはすべて入っている"
  else
    ng "入っていない GUI アプリがある"
    grep -v '^Satisfy' "$tmp/brew.out" | head -n 10 | while IFS= read -r line; do note "$line"; done
  fi
fi

# ---------------------------------------------------------------------------
section "Neovim"

if [ "$quick" -eq 1 ]; then
  note "省略した(--quick)"
else
  samples="$tmp/nvim"
  mkdir -p "$samples"
  cat >"$samples/sample.md" <<'EOF'
# sample

- [ ] todo

```lua
local function f(a, b)
  return a + b
end
```

```python
print(1)
```
EOF
  printf 'local function f(a, b)\n  return a + b\nend\n' >"$samples/sample.lua"
  printf 'def f(a):\n    return a\n' >"$samples/sample.py"
  printf 'const f = (a: number) => a;\n' >"$samples/sample.ts"
  printf '#!/bin/sh\necho hi\n' >"$samples/sample.sh"

  if DOTFILES_CHECK_DIR="$samples" nvim --headless "+luafile $repo/scripts/lib/nvim-check.lua" >"$tmp/nvim.out" 2>&1; then
    ok "ファイルを開き、全プラグインを読み込んでもエラーが出ない"
  else
    ng "Neovim でエラーが出る"
    head -n 30 "$tmp/nvim.out" | while IFS= read -r line; do note "$line"; done
  fi
fi

# ---------------------------------------------------------------------------
printf '\n'
if [ "$fail" -eq 0 ]; then
  printf '問題は見つからなかった。\n'
else
  printf '問題がある。上の ✗ を直してから、もう一度実行する。\n'
fi
exit "$fail"
